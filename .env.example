# Copy this file to .env and fill in real values. Never commit .env.
# Nothing here is needed to run the project on your laptop. These are for publishing
# to Supabase and for the API.

# Supabase -> your project -> Connect -> "Session pooler" connection string.
# (Use the pooler, not "Direct connection": the direct one needs IPv6, which many networks lack.)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Any long random string. The API requires it in the X-API-Key header.
# While this says change-me, the API on your laptop accepts the key: dev-key
API_KEY=change-me

# Optional: make the dataset smaller on a busy laptop (default 3000)
# CHURNLENS_ACCOUNTS=1000
